{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "p=$(printf %s \"$1\" | perl -pe 's@\\\\@/@g'); exec bash \"$p/scripts/import.sh\"",
              "session-sync",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "p=$(printf %s \"$1\" | perl -pe 's@\\\\@/@g'); exec bash \"$p/scripts/export.sh\"",
              "session-sync",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "shell": "bash"
          }
        ]
      }
    ]
  }
}